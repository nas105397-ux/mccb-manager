[Unit]
Description=MCCB Manager Chromium kiosk
After=graphical-session.target network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mccb-manager
Environment=DISPLAY=:0
Environment=GTK_IM_MODULE=fcitx
Environment=QT_IM_MODULE=fcitx
Environment=XMODIFIERS=@im=fcitx
Environment=XCURSOR_SIZE=24
Environment=APP_URL=https://localhost
Environment=KIOSK_MODE=dual
Environment=MAIN_GEOMETRY=1920x1080+0+0
Environment=DASHBOARD_GEOMETRY=3840x2160+1920+0
Environment=MAIN_SCALE=1
Environment=DASHBOARD_SCALE=1.5
Environment=DISPLAY_SLEEP_MODE=both
Environment=IDLE_SLEEP_MINUTES=30
Environment=SLEEP_START_TIME=20:00
Environment=SLEEP_END_TIME=06:00
Environment=ENABLE_GPU_TUNING=0
Environment="CHROMIUM_FLAGS=--disable-gpu-vsync --ignore-certificate-errors --unsafely-treat-insecure-origin-as-secure=https://localhost"
EnvironmentFile=-%h/.config/mccb-kiosk/kiosk.env
ExecStartPre=/bin/sleep 8
ExecStartPre=-/usr/bin/xset s off
ExecStartPre=-/usr/bin/xset -dpms
ExecStartPre=-/usr/bin/xset s noblank
ExecStart=%h/mccb-manager/deploy/kiosk/start-kiosk.sh
ExecStopPost=-/usr/bin/pkill -u %u -f /tmp/mccb-kiosk-
KillMode=mixed
TimeoutStopSec=10
SendSIGKILL=yes
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
